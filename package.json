{
  "name": "hudi-orb-generator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build-reference-brand-colours.mjs && next dev",
    "build": "node scripts/build-reference-brand-colours.mjs && next build",
    "build:catalog-review": "node scripts/build-logo-review-index.mjs",
    "build:figma": "node scripts/build-reference-brand-colours.mjs && node scripts/build-figma-plugin.mjs",
    "audit:catalog": "node scripts/render-logo-catalog-audit.mjs",
    "audit:logo-backgrounds": "node scripts/audit-logo-background-removal.mjs",
    "audit:logo-contrast": "node scripts/audit-logo-contrast.mjs",
    "audit:logo-sources": "node scripts/audit-logo-sources.mjs",
    "audit:logo-resolution": "node scripts/audit-logo-resolution.mjs",
    "download:logos": "node scripts/download-logo-assets.mjs",
    "enrich:orb-colours": "node scripts/enrich-orb-colours.mjs",
    "enrich:logo-colour-modes": "node scripts/enrich-logo-colour-modes.mjs",
    "export:catalog": "node scripts/export-orb-catalog.mjs",
    "finalize:catalog": "node scripts/finalize-logo-catalog.mjs",
    "import:catalog": "node scripts/import-community-logo-catalog.mjs",
    "import:crypto": "node scripts/import-crypto-logo-catalog.mjs",
    "materialize:open-logos": "npm run import:catalog -- --from-manifest --materialize-open-sources --skip-tradingview && npm run finalize:catalog && npm run report:logo-materialization",
    "process:logos": "node scripts/process-logo-assets.mjs",
    "report:logo-materialization": "node scripts/report-logo-materialization.mjs",
    "review:png-logos": "node scripts/build-png-logo-review.mjs",
    "search:logo-candidates": "node scripts/search-serpapi-logo-candidates.mjs",
    "start": "next start",
    "test:logo-pipeline": "node scripts/test-logo-pipeline.mjs",
    "test:crypto-catalog": "node scripts/test-crypto-catalog.mjs",
    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "opentype.js": "^2.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.130.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
